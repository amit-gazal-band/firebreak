# LLM backend "api" (llm.backend: api)
ANTHROPIC_API_KEY=

# LLM backend "claude-code" uses your local `claude` login,
# or a token from `claude setup-token`:
CLAUDE_CODE_OAUTH_TOKEN=

# Band team: agent credentials live in band_agents.yaml (see band_agents.yaml.example)
BAND_REST_URL=https://app.band.ai
BAND_WS_URL=wss://app.band.ai/api/v1/socket/websocket
