# Optional billed Anthropic backend (llm.backend: api).
# The default claude-code backend uses your local Claude subscription login instead.
ANTHROPIC_API_KEY=

# Optional billed OpenAI Responses backend (llm.backend: openai).
# The codex backend uses your local ChatGPT subscription login instead.
OPENAI_API_KEY=

# Optional non-interactive Claude subscription token:
CLAUDE_CODE_OAUTH_TOKEN=

# Band team: agent credentials live in band_agents.yaml (see band_agents.yaml.example)
BAND_REST_URL=https://app.band.ai
BAND_WS_URL=wss://app.band.ai/api/v1/socket/websocket
